{
  "name": "server-manager",
  "private": true,
  "version": "0.1.0",
  "description": "Game Server Manager - Local web panel for managing dedicated game servers",
  "scripts": {
    "dev:backend": "pnpm --filter backend dev",
    "dev:frontend": "pnpm --filter frontend start",
    "build:backend": "pnpm --filter backend build",
    "build:frontend": "pnpm --filter frontend build",
    "build:shared": "pnpm --filter @server-manager/shared build",
    "build": "pnpm build:shared && pnpm build:backend && pnpm build:frontend",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
