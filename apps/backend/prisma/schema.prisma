generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Server {
  id          Int       @id @default(autoincrement())
  name        String
  game        String
  status      String    @default("offline")
  path        String
  exePath     String
  configPath  String
  savePath    String
  steamAppId  String
  queryPort   Int
  gamePort    Int
  lastStartAt  DateTime?
  lastCrashAt  DateTime?
  lastBackupAt DateTime?
  lastUpdateAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  schedules Schedule[]
  backups   Backup[]
}

model Schedule {
  id             Int       @id @default(autoincrement())
  serverId       Int
  type           String
  cronExpression String
  enabled        Boolean   @default(true)
  payload        String?
  lastRunAt      DateTime?
  nextRunAt      DateTime?
  createdAt      DateTime  @default(now())

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
}

model Backup {
  id        Int      @id @default(autoincrement())
  serverId  Int
  path      String
  size      Int
  createdAt DateTime @default(now())

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
}

model Setting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}
